# Copy to gradle.properties.local (gitignored) if Gradle picks the wrong JDK.
# Typical symptom: "jlink executable ... does not exist"
#
# macOS + Android Studio:
# org.gradle.java.home=/Applications/Android Studio.app/Contents/jbr/Contents/Home

# ═══════════════════════════════════════════════════════════════════════════════
# delta-helper-app · 正式环境（onlineRelease / onlineDebug）
# ═══════════════════════════════════════════════════════════════════════════════

# 正式 API 根地址（必须以 / 结尾）
onlineApiBaseUrl=https://api.hzgsapp.com/

# 反代场景下覆盖 Host 头（直连可留空）
# onlineApiHostHeader=api.hzgsapp.com

# 发行渠道 key（请求头 X-Publisher-Key，online / daily 默认 official）
# publisherKey=official

# ═══════════════════════════════════════════════════════════════════════════════
# delta-helper-app · 小米渠道（xiaomiRelease / xiaomiDebug）
# ═══════════════════════════════════════════════════════════════════════════════

# 小米包默认 publisher=monster（可在 flavor 内覆盖）
# xiaomiPublisherKey=monster

# 小米 API（默认与 online 相同，可单独覆盖）
# xiaomiApiBaseUrl=https://monster.hk.cn/
# xiaomiApiHostHeader=

# ═══════════════════════════════════════════════════════════════════════════════
# delta-helper-app · 本地开发（dailyDebug / dailyRelease）
# ═══════════════════════════════════════════════════════════════════════════════

# 方案 A（默认，模拟器）：宿主机特殊地址
# dailyApiBaseUrl=http://10.0.2.2:8080/

# 方案 B（adb reverse 后）：
#   adb reverse tcp:8080 tcp:8080
# dailyApiBaseUrl=http://127.0.0.1:8080/

# 真机同一 WiFi：换成电脑局域网 IP
# dailyApiBaseUrl=http://192.168.x.x:8080/

# dailyApiHostHeader=

# ── Mock / 调试开关（按构建变体生效）──────────────────────────────────────────
#
# 变体默认行为：
#   dailyDebug   → mock=true,  simulate=true,  httpLog=true
#   dailyRelease → mock=false, simulate=false, httpLog=false
#   online*      → mock=false, simulate=false, httpLog=见下方
#
# dailyDebugMockAlreadyActivated=true      # true=跳过卡密直接可用
# dailyDebugSimulateNotActivated=true     # true=本地模拟未激活，兑换写本地 session
# dailyReleaseMockAlreadyActivated=false
# dailyReleaseSimulateNotActivated=false
# debugHttpLogging=true                    # 所有 *Debug 变体
# releaseHttpLogging=false                 # 所有 *Release 变体

# ═══════════════════════════════════════════════════════════════════════════════
# Release 签名（*Release 变体，如 onlineRelease / dailyRelease）
# ═══════════════════════════════════════════════════════════════════════════════
#
# 推荐：apps/delta-helper-app/key/signing.properties（见 key/signing.properties.example）
# 备选：在 gradle.properties.local 中配置 RELEASE_STORE_*（路径相对仓库根目录）

# RELEASE_STORE_FILE=apps/delta-helper-app/key/key.jks
# RELEASE_STORE_PASSWORD=***
# RELEASE_KEY_ALIAS=release
# RELEASE_KEY_PASSWORD=***
